# --- Airtable backend (server-side only — DO NOT prefix with VITE_) ---
# Get the token from https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write
# For initial setup (npm run setup), also temporarily add: schema.bases:read, schema.bases:write
AIRTABLE_TOKEN=

# Base ID — found in the base URL: airtable.com/<AIRTABLE_BASE_ID>/...
AIRTABLE_BASE_ID=

# Table ID — found in the base URL: airtable.com/<base>/<AIRTABLE_TABLE_ID>/...
AIRTABLE_TABLE_ID=
